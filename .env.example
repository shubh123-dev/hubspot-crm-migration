# HubSpot private-app token. Copy the HUBSPOT_TOKEN value from ai-sales-poc's .env.
# Needed scopes (read-only): crm.objects.companies.read, crm.objects.contacts.read,
# crm.objects.owners.read, crm.schemas.companies.read, crm.schemas.contacts.read,
# sales-email-read (email bodies). Notes/calls/meetings/tasks are covered by the
# contacts/companies read scopes.
HUBSPOT_TOKEN=

# Postgres connection string for the internal CRM.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Optional tuning
# HUBSPOT_BASE_URL=https://api.hubapi.com
# HUBSPOT_MIN_INTERVAL_MS=110   # ~9 req/s, well under the 100 req/10s private-app limit
# PGSSL=true                    # set for managed Postgres that requires TLS
